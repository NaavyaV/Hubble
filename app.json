{
  "expo": {
    "name": "utd-hangouts",
    "slug": "utd-hangouts",
    "version": "1.0.0",
    "main": "index.ts",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "hubble",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#3498db",
      "androidMode": "default",
      "androidCollapsedTitle": "Hubble"
    },
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "15.1",
      "infoPlist": {
        "UIBackgroundModes": [
          "background-fetch",
          "background-processing",
          "background-fetch",
          "background-processing",
          "background-fetch",
          "background-processing",
          "background-fetch",
          "background-processing"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.abcdefg123456710.utd-hangouts"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "package": "com.abcdefg123456710.utdhangouts"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3498db",
          "defaultChannel": "default"
        }
      ],
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "e9fca504-7f5e-4a42-a28f-c2feae7996c7"
      }
    }
  }
}

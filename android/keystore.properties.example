# Keystore configuration for release builds
# Copy this file to keystore.properties and fill in your actual values
# NEVER commit keystore.properties to git!

MYAPP_RELEASE_STORE_FILE=release.keystore
MYAPP_RELEASE_KEY_ALIAS=hubble-key
MYAPP_RELEASE_STORE_PASSWORD=your-keystore-password-here
MYAPP_RELEASE_KEY_PASSWORD=your-key-password-here

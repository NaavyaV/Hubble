  // Refresh events when the tab is focused
  useFocusEffect(
    React.useCallback(() => {
      console.log('Events tab focused - refreshing events')
      fetchEvents()
    }, [])
  )
      setEvents(eventsWithCounts)
      filterEvents(eventsWithCounts, activeFilter)
      
      // Fetch host profiles
      const hostIds = [...new Set(eventsWithCounts.map(event => event.host_id))]
      if (hostIds.length > 0) {
        const { data: profiles } = await supabase
          .from('profiles')
          .select('id, full_name')
          .in('id', hostIds)
        
        const profilesMap: Record<string, any> = {}
        profiles?.forEach(profile => {
          profilesMap[profile.id] = profile
      // Fetch current user's attendances
      await fetchUserAttendances(eventsWithCounts)

      // Fetch user's invitations
      await fetchUserInvitations(eventsWithCounts)
    } catch (error) {


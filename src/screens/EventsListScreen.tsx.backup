  const applyAdvancedFilters = (eventsList: EventWithAttendees[]) => {
    let filtered = eventsList

    if (advancedFilters.friendsOnly) {
      filtered = filtered.filter(event => {
        // Check if host is a friend or if any attendees are friends
        const isHostFriend = friends.has(event.host_id)
        const attendees = event.attendees || []
        const hasFriendAttendees = attendees.some((attendee: any) => 
          friends.has(attendee.user_id)
        )
        return isHostFriend || hasFriendAttendees

  useEffect(() => {

  const getInvitedEventIds = async (userId: string): Promise<string[]> => {
    try {
      const { data: invitations } = await supabase
        .from('event_invitations')
        .select('event_id')
        .eq('user_id', userId)
      
      return invitations?.map(inv => inv.event_id) || []

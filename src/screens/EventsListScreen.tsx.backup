      console.log('Events tab focused - refreshing events')
      fetchEvents()
    }, [])
  )
  const applySorting = (eventsList: EventWithAttendees[]) => {
    const sorted = [...eventsList]

    switch (sortBy) {
      case 'date_asc':
        return sorted.sort((a, b) => new Date(a.event_date).getTime() - new Date(b.event_date).getTime())
      case 'date_desc':
        return sorted.sort((a, b) => new Date(b.event_date).getTime() - new Date(a.event_date).getTime())
      case 'people_going':
        return sorted.sort((a, b) => {
          const aGoing = (a as any).going_count || 0
          const bGoing = (b as any).going_count || 0
          return bGoing - aGoing
        return sorted.sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())
      case 'alphabetical':
        return sorted.sort((a, b) => a.title.localeCompare(b.title))
      default:
        return sorted
    }

  useEffect(() => {
    fetchEvents()
  }, [])

  // Refresh events when the tab is focused
  useFocusEffect(
    React.useCallback(() => {
